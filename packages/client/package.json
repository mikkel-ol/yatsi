{
  "name": "@mikkel-ol/yatsi",
  "version": "1.0.1",
  "description": "Client CLI and library for YATSI, a self-hosted tunneling service. Expose a local HTTP, SSE, or WebSocket service through a temporary public URL.",
  "keywords": [
    "tunnel",
    "tunneling",
    "localhost",
    "expose",
    "http",
    "websocket",
    "sse",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikkel-ol/yatsi.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/mikkel-ol/yatsi#readme",
  "bugs": {
    "url": "https://github.com/mikkel-ol/yatsi/issues"
  },
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts"
  },
  "bin": "dist/cli.js",
  "dependencies": {
    "ws": "^8.18.1",
    "yargs": "^17.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@mikkel-ol/shared": "workspace:*",
    "@types/ws": "^8.18.0",
    "@types/yargs": "^17.0.33",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2"
  }
}
